generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CANDIDATE
}

enum PasswordTokenPurpose {
  INVITE
  RESET
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  email        String   @unique
  passwordHash String?  @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions            Session[]
  passwordTokens      PasswordToken[]
  candidate           Candidate?
  employee            Employee?
  assignmentsCreated  Assignment[]    @relation("AssignmentAssignedBy")
  applicationsSubmitted Application[] @relation("ApplicationSubmittedBy")
  auditLogs           AuditLog[]
  optimizedResumesCreated OptimizedResume[] @relation("OptimizedResumeCreatedBy")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordToken {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  tokenHash String               @unique @map("token_hash")
  purpose   PasswordTokenPurpose
  expiresAt DateTime             @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?            @map("used_at") @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_tokens")
}

model Candidate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Short, human-memorable reference (4-5 digits) used in URLs.
  code         Int      @unique @default(dbgenerated("nextval('candidate_code_seq'::regclass)"))
  userId       String   @unique @map("user_id") @db.Uuid
  email        String?
  phone        String?
  gender       String?
  address      String?
  primaryRole  String?  @map("primary_role")
  experience   String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments  Assignment[]
  applications Application[]
  optimizedResumes OptimizedResume[]

  @@map("candidates")
}

model Employee {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  name         String
  employeeCode String   @unique @map("employee_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@map("employees")
}

model Assignment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  assignedBy  String   @map("assigned_by") @db.Uuid
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assigner  User      @relation("AssignmentAssignedBy", fields: [assignedBy], references: [id])

  @@unique([employeeId, candidateId])
  @@index([employeeId])
  @@index([candidateId])
  @@map("assignments")
}

model Application {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId      String    @map("candidate_id") @db.Uuid
  companyName      String    @map("company_name")
  jobLink          String    @map("job_link")
  resumeLink       String?   @map("resume_link")
  probability      String?
  updates          String?
  commentsInternal String?   @map("comments_internal")
  submittedById    String?   @map("submitted_by") @db.Uuid
  appliedDate      DateTime  @map("applied_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  submittedBy User?     @relation("ApplicationSubmittedBy", fields: [submittedById], references: [id])

  @@index([candidateId, appliedDate(sort: Desc)])
  @@index([submittedById])
  @@index([companyName])
  @@map("applications")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model OptimizedResume {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId     String   @map("candidate_id") @db.Uuid
  createdById     String   @map("created_by_id") @db.Uuid
  companyName     String   @map("company_name")
  jobDescription  String   @map("job_description")
  contentMarkdown String   @map("content_markdown")
  atsScore        Int      @map("ats_score")
  scoreBreakdown  Json     @map("score_breakdown")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy User      @relation("OptimizedResumeCreatedBy", fields: [createdById], references: [id])

  @@index([candidateId])
  @@map("optimized_resumes")
}
